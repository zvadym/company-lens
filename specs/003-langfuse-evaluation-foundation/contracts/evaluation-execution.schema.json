{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company-lens.local/schemas/evaluation-execution.v1.json",
  "title": "CompanyLens Evaluation Execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "started_at",
    "completed_at",
    "status",
    "gate_status",
    "manifest",
    "runs",
    "failure_codes",
    "artifact_paths"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "execution_id": { "type": "string", "format": "uuid" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "partial", "errored"] },
    "gate_status": { "enum": ["passed", "failed", "not_evaluated"] },
    "manifest": { "$ref": "#/$defs/manifest" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/datasetRun" }
    },
    "failure_codes": { "$ref": "#/$defs/reasonCodes" },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journal", "json", "markdown"],
      "properties": {
        "journal": { "type": "string", "minLength": 1 },
        "json": { "type": "string", "minLength": 1 },
        "markdown": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": { "properties": { "gate_status": { "enum": ["passed", "failed"] } } },
      "else": { "properties": { "gate_status": { "const": "not_evaluated" } } }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "projectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_project_id",
        "resolved_project_id",
        "resolved_project_name",
        "status",
        "checked_at"
      ],
      "properties": {
        "expected_project_id": { "type": ["string", "null"] },
        "resolved_project_id": { "type": ["string", "null"] },
        "resolved_project_name": { "type": ["string", "null"] },
        "status": { "enum": ["verified", "mismatched", "unavailable"] },
        "checked_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["verified", "mismatched"] } } },
          "then": {
            "properties": {
              "expected_project_id": { "type": "string", "minLength": 1 },
              "resolved_project_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "datasetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_name",
        "repository_version",
        "source_path",
        "repository_hash",
        "langfuse_project_id",
        "langfuse_dataset_id",
        "version_timestamp",
        "active_item_ids",
        "active_item_hashes",
        "stale_item_ids",
        "selected_case_ids"
      ],
      "properties": {
        "dataset_name": { "type": "string", "minLength": 1 },
        "repository_version": { "type": "integer", "minimum": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "repository_hash": { "$ref": "#/$defs/sha256" },
        "langfuse_project_id": { "type": "string", "minLength": 1 },
        "langfuse_dataset_id": { "type": "string", "minLength": 1 },
        "version_timestamp": { "type": "string", "format": "date-time" },
        "active_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "active_item_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "stale_item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "selected_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "manifestDataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_name",
        "repository_version",
        "source_path",
        "repository_hash",
        "selected_case_ids",
        "preflight_status",
        "snapshot"
      ],
      "properties": {
        "dataset_name": { "type": "string", "minLength": 1 },
        "repository_version": { "type": "integer", "minimum": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "repository_hash": { "$ref": "#/$defs/sha256" },
        "selected_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "preflight_status": { "enum": ["verified", "failed"] },
        "snapshot": {
          "anyOf": [
            { "$ref": "#/$defs/datasetSnapshot" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "preflight_status": { "const": "verified" } } },
          "then": { "properties": { "snapshot": { "$ref": "#/$defs/datasetSnapshot" } } },
          "else": { "properties": { "snapshot": { "type": "null" } } }
        }
      ]
    },
    "gateManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_path", "content_hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "scoreConfigBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_name", "langfuse_config_id"],
      "properties": {
        "score_name": { "type": "string", "minLength": 1, "maxLength": 35 },
        "langfuse_config_id": { "type": "string", "minLength": 1 }
      }
    },
    "scoreContractManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source_path",
        "content_hash",
        "config_status",
        "config_bindings"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "config_status": { "enum": ["verified", "failed"] },
        "config_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/scoreConfigBinding" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "config_status": { "const": "verified" } } },
          "then": { "properties": { "config_bindings": { "minItems": 1 } } },
          "else": { "properties": { "config_bindings": { "maxItems": 0 } } }
        }
      ]
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "name", "reasoning_effort", "max_output_tokens"],
      "properties": {
        "purpose": { "enum": ["planning", "answer", "repair"] },
        "name": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "enum": ["none", "low", "medium", "high", "xhigh"] },
        "max_output_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "promptVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "version", "content_hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "componentVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parser", "embedding_model", "retrieval_index"],
      "properties": {
        "parser": { "type": "string", "minLength": 1 },
        "embedding_model": { "type": "string", "minLength": 1 },
        "retrieval_index": { "type": "string", "minLength": 1 }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_concurrency",
        "max_tool_calls",
        "max_retries_per_node",
        "max_repair_attempts",
        "max_cases_per_dataset"
      ],
      "properties": {
        "max_concurrency": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_retries_per_node": { "type": "integer", "minimum": 0 },
        "max_repair_attempts": { "type": "integer", "minimum": 0 },
        "max_cases_per_dataset": { "type": "integer", "minimum": 1 }
      }
    },
    "workflowMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_url", "actor"],
      "properties": {
        "run_url": { "type": ["string", "null"], "format": "uri" },
        "actor": { "type": ["string", "null"] }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_id",
        "replay_of_execution_id",
        "source_manifest_fingerprint",
        "manifest_fingerprint",
        "commit_sha",
        "source_ref",
        "environment",
        "service_version",
        "project_identity",
        "datasets",
        "gate",
        "score_contract",
        "models",
        "prompts",
        "versions",
        "execution_policy",
        "workflow"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "execution_id": { "type": "string", "format": "uuid" },
        "replay_of_execution_id": { "type": ["string", "null"], "format": "uuid" },
        "source_manifest_fingerprint": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "manifest_fingerprint": { "$ref": "#/$defs/sha256" },
        "commit_sha": { "type": "string", "pattern": "^[a-fA-F0-9]{7,40}$" },
        "source_ref": { "type": ["string", "null"] },
        "environment": { "type": "string", "minLength": 1 },
        "service_version": { "type": "string", "minLength": 1 },
        "project_identity": { "$ref": "#/$defs/projectIdentity" },
        "datasets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/manifestDataset" }
        },
        "gate": { "$ref": "#/$defs/gateManifest" },
        "score_contract": { "$ref": "#/$defs/scoreContractManifest" },
        "models": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/modelConfig" }
        },
        "prompts": {
          "type": "array",
          "items": { "$ref": "#/$defs/promptVersion" }
        },
        "versions": { "$ref": "#/$defs/componentVersions" },
        "execution_policy": { "$ref": "#/$defs/executionPolicy" },
        "workflow": { "$ref": "#/$defs/workflowMetadata" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "replay_of_execution_id": { "type": "string" } },
            "required": ["replay_of_execution_id"]
          },
          "then": {
            "properties": {
              "source_manifest_fingerprint": { "$ref": "#/$defs/sha256" },
              "project_identity": {
                "allOf": [
                  { "$ref": "#/$defs/projectIdentity" },
                  { "properties": { "status": { "const": "verified" } } }
                ]
              },
              "datasets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/manifestDataset" },
                    {
                      "properties": {
                        "preflight_status": { "const": "verified" },
                        "snapshot": { "$ref": "#/$defs/datasetSnapshot" }
                      }
                    }
                  ]
                }
              },
              "score_contract": {
                "allOf": [
                  { "$ref": "#/$defs/scoreContractManifest" },
                  {
                    "properties": {
                      "config_bindings": { "type": "array", "minItems": 1 },
                      "config_status": { "const": "verified" }
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": { "source_manifest_fingerprint": { "type": "null" } }
          }
        }
      ]
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "category", "passed", "checks", "failure_codes", "scores"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "passed": { "type": ["boolean", "null"] },
        "checks": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "failure_codes": { "$ref": "#/$defs/reasonCodes" },
        "scores": {
          "type": "object",
          "additionalProperties": { "type": ["boolean", "number", "string"] }
        }
      }
    },
    "datasetRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_name",
        "dataset_version",
        "snapshot",
        "status",
        "gate_status",
        "selected_case_ids",
        "case_results",
        "aggregate_scores",
        "langfuse_dataset_run_id",
        "langfuse_run_url"
      ],
      "properties": {
        "dataset_name": { "type": "string", "minLength": 1 },
        "dataset_version": { "type": "integer", "minimum": 1 },
        "snapshot": {
          "anyOf": [
            { "$ref": "#/$defs/datasetSnapshot" },
            { "type": "null" }
          ]
        },
        "status": { "enum": ["completed", "partial", "errored"] },
        "gate_status": { "enum": ["passed", "failed", "not_evaluated"] },
        "selected_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "case_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/caseResult" }
        },
        "aggregate_scores": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "langfuse_dataset_run_id": { "type": ["string", "null"] },
        "langfuse_run_url": { "type": ["string", "null"], "format": "uri" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } } },
          "then": {
            "properties": {
              "gate_status": { "enum": ["passed", "failed"] },
              "snapshot": { "$ref": "#/$defs/datasetSnapshot" }
            }
          },
          "else": { "properties": { "gate_status": { "const": "not_evaluated" } } }
        }
      ]
    }
  }
}
